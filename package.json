{
  "name": "ran-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "tauri:dev": "tauri dev",
    "tauri": "tauri",
    "copy:sidecar": "node -e \"const fs=require('fs'),p=require('path');try{fs.mkdirSync('src-tauri/binaries',{recursive:true});fs.copyFileSync('src-tauri/target/release/ran-sidecar.exe','src-tauri/binaries/ran-sidecar-x86_64-pc-windows-msvc.exe');console.log('sidecar copied')}catch(e){console.warn('sidecar not found, run cargo build --release first')};\"",
    "tauri:build": "pnpm copy:sidecar && tauri build"
  },
  "dependencies": {
    "@antv/g2plot": "^2.4.35",
    "@element-plus/icons-vue": "^2.3.2",
    "@rsbuild/core": "^2.1.8",
    "@rsbuild/plugin-vue": "^2.0.1",
    "@rsbuild/plugin-vue-jsx": "^2.0.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "element-plus": "^2.14.3",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@rsbuild/plugin-babel": "^2.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.1",
    "typescript": "~5.6.3"
  }
}
